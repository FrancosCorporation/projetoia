# Token do BotFather. Mantenha este arquivo de exemplo sem segredos reais.
TELEGRAM_TOKEN=
# IDs numéricos dos usuários autorizados, separados por vírgula.
TELEGRAM_ALLOWED_USER_IDS=

# Endereço do Ollama visto pelos containers.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
WHISPER_MODEL=small

# Gere cada segredo de forma independente com: openssl rand -hex 32
SEARXNG_SECRET=
OPEN_WEBUI_SECRET_KEY=
